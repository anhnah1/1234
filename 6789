      const secs = usedTimeInSeconds % 60;
      const formattedTime = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;

      document.getElementById('result-name').textContent = playerName;
      document.getElementById('result-score').textContent = score;
      document.getElementById('result-time').textContent = formattedTime;

      luuLenFirebase(playerName, score, usedTimeInSeconds, formattedTime);
