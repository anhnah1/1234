<!DOCTYPE html>
<html lang="vi" class="notranslate" translate="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google" content="notranslate">
  <title>Trạng Nguyên Tiếng Việt - Khảo Thí Sĩ Tử 📜</title>
  
  <!-- Firebase SDK v8 -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/firebase/8.10.1/firebase-app.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/firebase/8.10.1/firebase-database.min.js"></script>

  <!-- Google Fonts: Font chữ truyền thống/tiểu học -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@600;700&display=swap" rel="stylesheet">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Comfortaa', 'Segoe UI', cursive, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: #fef3c7 url('https://www.transparenttextures.com/patterns/oriental-tiles.png');
      color: #451a03;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 12px;
    }

    /* Container Khung Bảng Vàng / Cuộn Thư */
    .container {
      width: 100%;
      max-width: 720px;
      background: #fffbeb;
      border: 4px solid #b45309;
      outline: 4px solid #fef3c7;
      border-radius: 20px;
      padding: 24px;
      box-shadow: 0 10px 30px rgba(180, 83, 9, 0.3);
      margin-top: 10px;
      margin-bottom: 30px;
      position: relative;
    }

    .main-title {
      text-align: center;
      color: #991b1b;
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 8px;
      text-transform: uppercase;
      text-shadow: 1px 1px 0px #fef3c7, 2px 2px 0px #b45309;
    }

    .sub-title {
      text-align: center;
      color: #b45309;
      font-size: 15px;
      margin-bottom: 20px;
      font-weight: 600;
    }

    .topic-tag {
      display: inline-block;
      background: #fef08a;
      color: #9a3412;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: bold;
      margin-bottom: 8px;
      border: 1px solid #fde047;
    }

    .hidden { display: none !important; }

    input[type="text"] {
      width: 100%;
      padding: 14px;
      border-radius: 12px;
      border: 2px solid #d97706;
      background: #fff;
      color: #78350f;
      font-size: 16px;
      margin-bottom: 18px;
      outline: none;
      font-weight: 600;
      text-align: center;
    }

    input[type="text"]:focus {
      border-color: #991b1b;
      box-shadow: 0 0 8px rgba(153, 27, 27, 0.3);
    }

    button {
      width: 100%;
      padding: 14px;
      border-radius: 12px;
      border: 2px solid #78350f;
      background: linear-gradient(180deg, #f59e0b 0%, #d97706 100%);
      color: #fff;
      font-weight: bold;
      font-size: 17px;
      cursor: pointer;
      box-shadow: 0 4px 0 #78350f;
      transition: all 0.1s ease;
      text-shadow: 1px 1px 2px rgba(0,0,0,0.4);
    }

    button:hover {
      background: linear-gradient(180deg, #fbbf24 0%, #d97706 100%);
    }

    button:active {
      transform: translateY(3px);
      box-shadow: 0 1px 0 #78350f;
    }

    .sticky-header {
      position: sticky;
      top: 10px;
      z-index: 100;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: linear-gradient(90deg, #991b1b 0%, #b91c1c 100%);
      color: #fff;
      padding: 10px 18px;
      border-radius: 30px;
      margin-bottom: 24px;
      font-weight: bold;
      border: 2px solid #fef3c7;
      box-shadow: 0 5px 15px rgba(153, 27, 27, 0.4);
    }

    .question-card {
      background: #fff;
      border: 2px solid #fde68a;
      border-left: 6px solid #d97706;
      border-radius: 12px;
      padding: 18px;
      margin-bottom: 20px;
      box-shadow: 0 3px 10px rgba(0,0,0,0.04);
    }

    .question-title {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 14px;
      line-height: 1.6;
      color: #78350f;
    }

    .options {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .option-item {
      display: flex;
      align-items: center;
      background: #fefce8;
      padding: 12px 16px;
      border-radius: 10px;
      border: 1px solid #fef08a;
      cursor: pointer;
      transition: all 0.2s;
    }

    .option-item:hover {
      background: #fef9c3;
      border-color: #fde047;
    }

    .option-item input[type="radio"] {
      margin-right: 12px;
      width: 20px;
      height: 20px;
      accent-color: #b91c1c;
      cursor: pointer;
    }

    .option-item label {
      cursor: pointer;
      font-size: 15px;
      line-height: 1.4;
      width: 100%;
      color: #451a03;
      font-weight: 600;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
      font-size: 14px;
      background: #fff;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid #fde68a;
    }

    th, td {
      padding: 12px 10px;
      text-align: center;
      border-bottom: 1px solid #fef08a;
    }

    th {
      background: #78350f;
      color: #fef3c7;
      font-size: 15px;
    }

    .rank-1 { background: #fef08a; color: #78350f; font-weight: bold; }
    .rank-2 { background: #f1f5f9; color: #334155; font-weight: bold; }
    .rank-3 { background: #ffedd5; color: #9a3412; font-weight: bold; }
  </style>
</head>
<body>

  <div class="container">
    
    <!-- 1. MÀN HÌNH BẮT ĐẦU -->
    <div id="start-screen">
      <div style="text-align: center; margin-bottom: 10px;">
        <span style="font-size: 40px;">🚩📜</span>
      </div>
      <h1 class="main-title">Trạng Nguyên Tiếng Việt</h1>
      <p class="sub-title">Chủ đề: Đội TNTP Hồ Chí Minh - Bác Hồ với Thiếu Nhi - Truyền Thống</p>
      
      <div style="max-width: 400px; margin: 0 auto;">
        <input type="text" id="player-name" placeholder="Nhập Họ & Tên Sĩ Tử..." maxlength="30" autocomplete="off">
        <button type="button" id="btn-bat-dau" onclick="batDauLamBai()">Vào Thi Ngay ✍️</button>
      </div>
    </div>

    <!-- 2. MÀN HÌNH CÂU HỎI -->
    <div id="quiz-screen" class="hidden">
      <div class="sticky-header">
        <span id="answered-count" style="color: #fef08a;">Đã làm: 0/30</span>
        <span class="timer" id="timer-display">⏱️ 30:00</span>
      </div>
      
      <div id="quiz-list-container"></div>

      <button type="button" id="btn-nop-bai" onclick="xacNhanNopBai()" style="margin-top: 10px; font-size: 18px; padding: 16px; background: linear-gradient(180deg, #dc2626 0%, #991b1b 100%);">
        Nộp Bài Thi 🎯
      </button>
    </div>

    <!-- 3. MÀN HÌNH KẾT QUẢ & BẢNG VÀNG -->
    <div id="result-screen" class="hidden">
      <h1 class="main-title">🎉 KẾT QUẢ BÀI THI 🎉</h1>
      <p style="text-align: center; font-size: 16px; margin-bottom: 8px; color: #78350f;">
        Sĩ tử: <strong id="result-name" style="color: #991b1b; font-size: 18px;">-</strong>
      </p>
      <p style="text-align: center; font-size: 18px; margin-bottom: 20px; color: #78350f;">
        Điểm số: <strong id="result-score" style="color: #15803d; font-size: 24px;">0</strong> / 30 
        (<span id="result-time" style="color: #b45309;">00:00</span>)
      </p>

      <h2 style="text-align: center; color: #991b1b; font-size: 18px; margin-bottom: 10px;">🏆 BẢNG VÀNG TRẠNG NGUYÊN (TOP 10)</h2>
      <table>
        <thead>
          <tr>
            <th>Hạng</th>
            <th>Sĩ Tử</th>
            <th>Điểm</th>
            <th>Thời Gian</th>
          </tr>
        </thead>
        <tbody id="leaderboard-body">
          <tr><td colspan="4" style="text-align:center;">Đang tải bảng vàng...</td></tr>
        </tbody>
      </table>

      <button type="button" onclick="location.reload()" style="margin-top: 20px;">Thi Lại 🔄</button>
    </div>

  </div>

  <script>
    // NGÂN HÀNG CÂU HỎI MỞ RỘNG
    const rawQuestionBank = [
      // CHỦ ĐỀ 1: BÁC HỒ VỚI THIẾU NHI
      { topic: "Bác Hồ & Thiếu Nhi", q: "Điều đầu tiên trong 5 điều Bác Hồ dạy thiếu niên, nhi đồng là gì?", a: ["Yêu Tổ quốc, yêu đồng bào", "Học tập tốt, lao động tốt", "Đoàn kết tốt, kỷ luật tốt", "Giữ gìn vệ sinh thật tốt"], correct: 0 },
      { topic: "Bác Hồ & Thiếu Nhi", q: "Điều thứ 5 trong 5 điều Bác Hồ dạy thiếu niên, nhi đồng là gì?", a: ["Khiêm tốn, thật thà, dũng cảm", "Giữ gìn vệ sinh thật tốt", "Đoàn kết tốt, kỷ luật tốt", "Yêu Tổ quốc, yêu đồng bào"], correct: 0 },
      { topic: "Bác Hồ & Thiếu Nhi", q: "Nhạc sĩ nào là tác giả của bài hát nổi tiếng 'Ai yêu Bác Hồ Chí Minh hơn thiếu niên nhi đồng'?", a: ["Phong Nhã", "Phạm Tuyên", "Trịnh Công Sơn", "Văn Cao"], correct: 0 },
      { topic: "Bác Hồ & Thiếu Nhi", q: "Bác Hồ gửi bức thư đầu tiên cho thiếu nhi nhân dịp Tết Trung Thu vào năm nào?", a: ["Năm 1945", "Năm 1954", "Năm 1960", "Năm 1930"], correct: 0 },
      { topic: "Bác Hồ & Thiếu Nhi", q: "Năm điều Bác Hồ dạy thiếu niên, nhi đồng được Bác gửi nhân dịp kỷ niệm bao nhiêu năm thành lập Đội (1961)?", a: ["20 năm", "10 năm", "15 năm", "25 năm"], correct: 0 },
      { topic: "Bác Hồ & Thiếu Nhi", q: "Bài hát nào sau đây thể hiện tình cảm kính yêu của thiếu nhi dành cho Bác Hồ?", a: ["Bác Hồ người cho em tất cả", "Tiến quân ca", "Lên đàng", "Hành quân xa"], correct: 0 },
      { topic: "Bác Hồ & Thiếu Nhi", q: "Hình ảnh Bác Hồ quàng khăn đỏ cho thiếu nhi thể hiện điều gì?", a: ["Sự quan tâm, yêu thương gửi gắm thế hệ măng non", "Sự khen thưởng cá nhân", "Nghi lễ hành chính", "Sự nhắc nhở học tập"], correct: 0 },

      // CHỦ ĐỀ 2: ĐỘI THIẾU NIÊN TIỀN PHONG HỒ CHÍ MINH
      { topic: "Đội TNTP Hồ Chí Minh", q: "Đội Thiếu niên Tiền phong Hồ Chí Minh được thành lập vào ngày tháng năm nào?", a: ["15/5/1941", "19/5/1890", "26/3/1931", "2/9/1945"], correct: 0 },
      { topic: "Đội TNTP Hồ Chí Minh", q: "Người người đội trưởng đầu tiên của Đội Thiếu niên Tiền phong Hồ Chí Minh là ai?", a: ["Kim Đồng (Nông Văn Dền)", "Vừ A Dính", "Lê Văn Tám", "Nguễn Văn Trỗi"], correct: 0 },
      { topic: "Đội TNTP Hồ Chí Minh", q: "Khăn quàng đỏ của Đội viên Đội TNTP Hồ Chí Minh có hình dạng gì?", a: ["Hình tam giác cân", "Hình vuông", "Hình chữ nhật", "Hình tròn"], correct: 0 },
      { topic: "Đội TNTP Hồ Chí Minh", q: "Khăn quàng đỏ tượng trưng cho điều gì?", a: ["Một phần lá cờ Tổ quốc và máu thắm của các anh hùng liệt sĩ", "Màu nắng bình minh", "Sự nhiệt huyết tuổi trẻ", "Tình bạn thắm thiết"], correct: 0 },
      { topic: "Đội TNTP Hồ Chí Minh", q: "Bài hát chính thức (Đội ca) của Đội TNTP Hồ Chí Minh có tên là gì?", a: ["Cùng nhau đi lên", "Đội ca vang ca", "Tiến lên đoàn viên", "Măng non Việt Nam"], correct: 0 },
      { topic: "Đội TNTP Hồ Chí Minh", q: "Tác giả của bài hát Đội ca ('Cùng nhau đi lên') là ai?", a: ["Phong Nhã", "Lưu Hữu Phước", "Hoàng Vân", "Huy Du"], correct: 0 },
      { topic: "Đội TNTP Hồ Chí Minh", q: "Khi mới thành lập vào năm 1941, Đội TNTP Hồ Chí Minh có tên gọi là gì?", a: ["Hội Nhi đồng Cứu quốc", "Đội Tiền phong", "Hội Măng non", "Đội Thiếu niên Cứu quốc"], correct: 0 },
      { topic: "Đội TNTP Hồ Chí Minh", q: "Huy hiệu Đội TNTP Hồ Chí Minh có hình ảnh biểu tượng nổi bật nào ở giữa?", a: ["Búp măng non trên nền cờ đỏ sao vàng", "Cuốn sách mở ra", "Ngôi sao năm cánh", "Chim bồ câu trắng"], correct: 0 },
      { topic: "Đội TNTP Hồ Chí Minh", q: "Khẩu hiệu của Đội TNTP Hồ Chí Minh bắt đầu bằng từ nào?", a: ["Vì tổ quốc xã hội chủ nghĩa... Sẵn sàng!", "Vì tương lai đất nước... Tiến lên!", "Học tập tốt... Sẵn sàng!", "Rèn luyện thân thể... Sẵn sàng!"], correct: 0 },
      { topic: "Đội TNTP Hồ Chí Minh", q: "Địa danh nào là nơi thành lập Đội Thiếu niên Tiền phong Hồ Chí Minh?", a: ["Pắc Bó, Hà Quảng, Cao Bằng", "Tân Trào, Tuyên Quang", "Điện Biên Phủ", "Hà Nội"], correct: 0 },

      // CHỦ ĐỀ 3: VĂN HÓA DÂN GIAN & TRUNG THU
      { topic: "Văn Hóa - Dân Gian", q: "Chú Cuội gắn liền với hình ảnh cây gì dưới gốc nguyệt?", a: ["Cây Đa", "Cây Bàng", "Cây Tre", "Cây Đào"], correct: 0 },
      { topic: "Văn Hóa - Dân Gian", q: "Tết Trung Thu diễn ra vào ngày mấy Âm lịch hàng năm?", a: ["15/8", "15/7", "1/8", "30/8"], correct: 0 },
      { topic: "Văn Hóa - Dân Gian", q: "Loại đèn chơi Trung Thu truyền thống nào tự quay nhờ sức nóng của nến?", a: ["Đèn Kéo Quân", "Đèn Ông Sao", "Đèn Cá Chép", "Đèn Lồng Giấy"], correct: 0 },
      { topic: "Văn Hóa - Dân Gian", q: "Tết Trung Thu còn được gọi bằng tên nào thể hiện sự đoàn tụ gia đình?", a: ["Tết Đoàn Viên", "Tết Hàn Thực", "Tết Trùng Cửu", "Tết Đoan Ngọ"], correct: 0 },
      { topic: "Văn Hóa - Dân Gian", q: "Con vật nào được coi là bạn đồng hành cùng Hằng Nga trên Cung Trăng?", a: ["Thỏ Ngọc", "Mèo Máy", "Chó Vàng", "Cáo Tuyết"], correct: 0 },
      { topic: "Văn Hóa - Dân Gian", q: "Đồ chơi dân gian Trung Thu làm bằng bột gạo nhuộm màu gọi là gì?", a: ["Tò he", "Búp bê", "Mặt nạ giấy", "Đèn lon"], correct: 0 },
      { topic: "Văn Hóa - Dân Gian", q: "Chiếc Đèn Ông Sao truyền thống có mấy cánh?", a: ["5 cánh", "6 cánh", "4 cánh", "8 cánh"], correct: 0 },
      { topic: "Văn Hóa - Dân Gian", q: "Bánh Dẻo truyền thống được làm chính từ loại bột nào?", a: ["Bột gạo nếp rang chín", "Bột mì", "Bột năng", "Bột ngô"], correct: 0 },
      { topic: "Văn Hóa - Dân Gian", q: "Nhân vật bụng to, tay cầm quạt giấy nhảy múa vui vẻ cùng Kỳ Lân là ai?", a: ["Ông Địa", "Chú Cuội", "Trạng Tí", "Thần Tài"], correct: 0 },
      { topic: "Văn Hóa - Dân Gian", q: "Bài hát 'Đêm Trung Thu' có câu 'Thùng tùng rinh rinh...' tả tiếng gì?", a: ["Tiếng trống rước đèn", "Tiếng pháo hoa", "Tiếng chuông", "Tiếng sấm"], correct: 0 },
      { topic: "Văn Hóa - Dân Gian", q: "Hình ảnh Lân - Sư - Rồng múa vào đêm lễ hội tượng trưng cho điều gì?", a: ["May mắn & Thịnh vượng", "Sự xui xẻo", "Cầu mưa", "Mùa màng thất thu"], correct: 0 },
      { topic: "Văn Hóa - Dân Gian", q: "Thức bánh truyền thống không thể thiếu trong dịp Tết Trung Thu Việt Nam là gì?", a: ["Bánh Nướng & Bánh Dẻo", "Bánh Chưng", "Bánh Giầy", "Bánh Bò"], correct: 0 },
      { topic: "Văn Hóa - Dân Gian", q: "Trẻ em Việt Nam thường thực hiện hoạt động nào vào đêm Rằm?", a: ["Rước đèn phá cỗ", "Hái lộc xuân", "Xông nhà", "Thả hoa đăng"], correct: 0 }
    ];

    let db = null;
    let playerName = "";
    let selectedQuestions = [];
    let userAnswers = {};
    let timerInterval = null;
    let totalSeconds = 1800;

    // KHỞI TẠO FIREBASE
    try {
      if (typeof firebase !== 'undefined' && !firebase.apps.length) {
        firebase.initializeApp({
          databaseURL: "https://dulieu-327e5-default-rtdb.asia-southeast1.firebasedatabase.app"
        });
        db = firebase.database();
      }
    } catch (e) {
      console.error("Lỗi khởi tạo Firebase:", e);
    }

    function batDauLamBai() {
      const inputVal = document.getElementById('player-name').value.trim();
      if (!inputVal) {
        alert("Vui lòng nhập họ tên sĩ tử!");
        return;
      }

      playerName = inputVal;
      userAnswers = {};

      // Xáo trộn ngân hàng câu hỏi và lấy 30 câu ngẫu nhiên
      selectedQuestions = [...rawQuestionBank].sort(() => 0.5 - Math.random()).slice(0, 30);

      document.getElementById('start-screen').classList.add('hidden');
      document.getElementById('quiz-screen').classList.remove('hidden');

      hienThiDanhSachCauHoi();
      chayDemGio();
    }

    function hienThiDanhSachCauHoi() {
      const container = document.getElementById('quiz-list-container');
      container.innerHTML = '';

      selectedQuestions.forEach((qObj, qIndex) => {
        const card = document.createElement('div');
        card.className = 'question-card';

        let optionsHTML = '';
        qObj.a.forEach((optText, optIndex) => {
          optionsHTML += `
            <div class="option-item" onclick="chonDapAn(${qIndex}, ${optIndex})">
              <input type="radio" name="q_${qIndex}" id="q_${qIndex}_opt_${optIndex}" value="${optIndex}">
              <label for="q_${qIndex}_opt_${optIndex}">${optText}</label>
            </div>
          `;
        });

        card.innerHTML = `
          <div><span class="topic-tag">📌 ${qObj.topic}</span></div>
          <div class="question-title">Câu ${qIndex + 1}: ${qObj.q}</div>
          <div class="options">${optionsHTML}</div>
        `;

        container.appendChild(card);
      });
    }

    function chonDapAn(qIndex, optIndex) {
      const radio = document.getElementById(`q_${qIndex}_opt_${optIndex}`);
      if (radio) {
        radio.checked = true;
        userAnswers[qIndex] = optIndex;
        
        const answeredCount = Object.keys(userAnswers).length;
        document.getElementById('answered-count').textContent = `Đã làm: ${answeredCount}/30`;
      }
    }

    function chayDemGio() {
      const timerDisplay = document.getElementById('timer-display');
      timerInterval = setInterval(() => {
        if (totalSeconds <= 0) {
          clearInterval(timerInterval);
          alert("Đã hết giờ thi!");
          tinhDiemVaKetThuc();
          return;
        }
        totalSeconds--;
        const mins = Math.floor(totalSeconds / 60);
        const secs = totalSeconds % 60;
        timerDisplay.textContent = `⏱️ ${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
      }, 1000);
    }

    function xacNhanNopBai() {
      const answeredCount = Object.keys(userAnswers).length;
      if (answeredCount < 30) {
        if (!confirm(`Bạn mới trả lời ${answeredCount}/30 câu. Có chắc muốn nộp bài sớm không?`)) {
